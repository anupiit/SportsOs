{
  "name": "sportsos",
  "version": "0.1.0",
  "private": true,
  "description": "SportsOS — AI-powered Sports ERP for IIT (ISM) Dhanbad",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build:shared": "npm run build -w @sportsos/shared",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run prisma:migrate -w @sportsos/api",
    "db:seed": "npm run seed -w @sportsos/api",
    "dev:api": "npm run start:dev -w @sportsos/api",
    "dev:web": "npm run dev -w @sportsos/web",
    "build": "npm run build:shared && npm run build -w @sportsos/api && npm run build -w @sportsos/web",
    "test": "npm run build:shared && npm test -w @sportsos/api",
    "postinstall": "npm run build:shared"
  },
  "engines": {
    "node": ">=20"
  }
}
