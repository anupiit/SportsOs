# --- core
PORT=4000
DATABASE_URL=postgresql://sportsos:sportsos@localhost:5432/sportsos?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
ALLOWED_EMAIL_DOMAIN=iitism.ac.in

# --- AI analytics suite (both optional; SportsOS degrades to offline mode without them)
# Claude: an API key, or leave empty and run `ant auth login` on the host.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Pinecone integrated-embedding index (created automatically if missing). Empty = in-process vector store.
PINECONE_API_KEY=
PINECONE_INDEX=sportsos-knowledge
PINECONE_NAMESPACE=iitism
