{
  "name": "@sportsos/api",
  "version": "0.1.0",
  "private": true,
  "description": "SportsOS backend \u2014 NestJS + Prisma + PostgreSQL",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "jest",
    "postinstall": "prisma generate",
    "test:smoke": "node test/smoke.mjs",
    "test:e2e": "node test/rbac.e2e.mjs",
    "bootstrap:admin": "tsx prisma/bootstrap-admin.ts",
    "lint": "eslint src test prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.7.1",
    "@pinecone-database/pinecone": "9.1.0",
    "@prisma/client": "6.19.3",
    "@sportsos/shared": "*",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.12",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
